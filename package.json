{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "lib/integrations/*",
    "scripts"
  ],
  "scripts": {
    "build": "npm run build --workspace=@workspace/medprix-dashboard",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs",
    "db:migrate": "npm --workspace=@workspace/db run migrate",
    "db:seed": "npm --workspace=@workspace/db run seed",
    "dev": "node scripts/start-all.mjs"
  },
  "private": true,
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "pg-gateway": "^0.3.0-beta.4",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3"
  }
}
